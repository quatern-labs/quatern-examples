<?xml version="1.0"?>
<!--
  my_rover: a small differential-drive base with a 2D lidar, written for the
  quatern-examples tour. Primitive geometry only, so no meshes to ship.

  The wheels are fixed links: the base is driven through its velocity
  command, as most ROS 2 diff-drive bases are. The lidar is declared with the
  Gazebo <sensor> extension, which is what most real URDFs already carry;
  quatern init with a URDF reads its type ("ray") and makes it a laserscan.
-->
<robot name="my_rover">

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.035"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry><cylinder radius="0.15" length="0.10"/></geometry>
    </collision>
  </link>

  <link name="wheel_left">
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.035" length="0.02"/></geometry>
    </collision>
  </link>
  <joint name="wheel_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="0 0.12 0.035" rpy="0 0 0"/>
  </joint>

  <link name="wheel_right">
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.035" length="0.02"/></geometry>
    </collision>
  </link>
  <joint name="wheel_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="0 -0.12 0.035" rpy="0 0 0"/>
  </joint>

  <link name="laser_link">
    <collision>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.04 0 0.16" rpy="0 0 0"/>
  </joint>

  <gazebo reference="laser_link">
    <sensor name="scan" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
    </sensor>
  </gazebo>

</robot>
